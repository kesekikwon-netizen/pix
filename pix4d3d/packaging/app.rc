      VALUE "ProductName", "발굴 단면뷰어\0"
      VALUE "ProductVersion", "1.2.1\0"
      VALUE "LegalCopyright", "Qt (LGPLv3), OpenCTM (zlib), stb, nlohmann/json\0"
